<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <div class="navbar-item nds-brand">
        <a class="nds-brand__logo" href="https://www.neptune-software.com/" target="_blank" rel="noopener" title="Neptune Software website">{{> neptune-logo}}</a>
        <a class="nds-sublogo" href="{{{siteRootPath}}}/neptune-dxp/index.html" title="Documentation home">Documentation</a>
      </div>
      {{!-- The landing layout renders its own large search (partials/landing-hero.hbs) with the same ids. --}}
      {{#unless (eq page.layout 'landing')}}
      <button class="search-toggle-btn" id="search-toggle-btn" aria-label="Toggle search">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      {{/unless}}
      {{!-- Second copy so the theme switch stays visible when .navbar-menu collapses behind the burger (< 1024px). --}}
      <div class="navbar-item nds-theme-item--compact">
        {{> theme-switch}}
      </div>
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    {{#unless (eq page.layout 'landing')}}
    <div class="navbar-item searchbar">
      <div class="searchbar-wrapper">
        <input type="search" id="searchbar" placeholder="Search" autocomplete="off">
        <button class="search-submit-btn" id="search-submit-btn" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div>
    </div>
    {{/unless}}
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="https://portal.neptune-software.com/launchpad/portal#learning-hub" target="_blank" ><span>E-Learning</span></a>
        <a class="navbar-item" href="https://community.neptune-software.com" target="_blank" ><span>Community</span></a>
        <a class="navbar-item" href="https://portal.neptune-software.com/launchpad/portal" target="_blank" ><span>DXP Portal</span></a>
        <a class="navbar-item" href="https://support.neptune-software.com" target="_blank" ><span>Support</span></a>
        <div class="navbar-item">
          <span class="control main-nav--free-trial">
            <a class="is-primary" href="https://www.neptune-software.com/free-trial/" target="_blank" >Start Free Trial</a>
          </span>
        </div>
        <div class="navbar-item nds-theme-item">
          {{> theme-switch}}
        </div>
      </div>
    </div>
  </nav>
</header>
