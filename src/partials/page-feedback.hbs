<section class="page-feedback hide-for-print" data-component="{{page.component.name}}" data-component-title="{{page.component.title}}" data-version="{{page.version}}" data-module="{{page.module}}">
  <div class="page-feedback-prompt">
    <span class="page-feedback-question">Was this page helpful?</span>
    <button type="button" class="page-feedback-vote" data-helpful="true" aria-label="Yes, this page was helpful" title="Yes">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
    </button>
    <button type="button" class="page-feedback-vote" data-helpful="false" aria-label="No, this page was not helpful" title="No">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3H10z"/><path d="M17 2h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/></svg>
    </button>
  </div>
  <p class="page-feedback-thanks" role="status" hidden>Thank you for your feedback!</p>
  <dialog class="page-feedback-dialog" aria-labelledby="page-feedback-dialog-title">
    <form method="dialog" class="page-feedback-form">
      <p class="page-feedback-dialog-title" id="page-feedback-dialog-title"></p>
      <!-- Reason values are stored codes; keep them stable. -->
      <fieldset class="page-feedback-reasons" data-helpful="true">
        <legend>What made the biggest difference for you?</legend>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="solved-problem"> Solved my problem</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="easy-steps"> Steps were easy to understand</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="well-structured"> Well structured</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="plain-language"> Plain language</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="helpful-visuals"> Helpful visuals</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="other"> Other</label>
      </fieldset>
      <fieldset class="page-feedback-reasons" data-helpful="false">
        <legend>What went wrong? (Your feedback helps us fix it.)</legend>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="screen-mismatch"> What I saw didn’t match my screen</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="steps-failed"> Steps didn’t work</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="hard-to-understand"> Hard to understand</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="missing-details"> Missing details</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="needs-visuals"> Needs more visuals</label>
        <label class="page-feedback-reason"><input type="checkbox" name="reason" value="other"> Other</label>
      </fieldset>
      <label class="page-feedback-label" for="page-feedback-comment">Tell us more (optional)</label>
      <textarea class="page-feedback-comment" id="page-feedback-comment" name="comment" rows="4" maxlength="2000"></textarea>
      <p class="page-feedback-note">Please don't include personal or sensitive data.</p>
      <p class="page-feedback-error" role="alert" hidden>Your feedback could not be sent. Please try again.</p>
      <div class="page-feedback-actions">
        <button type="button" class="page-feedback-cancel">Cancel</button>
        <button type="submit" class="page-feedback-submit">Send feedback</button>
      </div>
    </form>
  </dialog>
</section>
